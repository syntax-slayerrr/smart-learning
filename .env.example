# ==============================================================================
# SYNTAX SLAYER SMART LEARNING — ENVIRONMENT CONFIGURATION TEMPLATE
# Salin file ini menjadi .env.local dan isi kredensial yang sesuai:
#   cp .env.example .env.local
# ==============================================================================

# --- Institution / School Branding (White-label Support) ---
NEXT_PUBLIC_SCHOOL_NAME="SYNTAX SLAYER SMART LEARNING"
NEXT_PUBLIC_SCHOOL_TAGLINE="AI Smart Learning Ecosystem"

# --- Supabase Database & Auth Configuration ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.dummy_anon_key
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.dummy_service_role_key

# --- Edge Device Security (CV Engine to Next.js API) ---
EDGE_DEVICE_SECRET=dev-edge-secret-key-2026

# --- Base Application URL ---
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Edge Vision Server URL (Kamera CCTV / Edge Engine) ---
NEXT_PUBLIC_EDGE_SERVER=http://localhost:5000

# --- Web Push Protocol (PWA & Mobile Notification to Parents/Teachers) ---
# Generate menggunakan: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your_vapid_public_key_here
VAPID_PRIVATE_KEY=your_vapid_private_key_here
VAPID_SUBJECT=mailto:admin@smkti-syntaxslayer.sch.id

# --- WhatsApp Gateway Service (Opsional / Fonnte / Wablas / Twilio) ---
WHATSAPP_API_TOKEN=your_whatsapp_gateway_token
WHATSAPP_API_URL=https://api.fonnte.com/send

# --- Local AI LLM Gateway (9Router / Hermes Daemon) ---
NINEROUTER_BASE_URL=http://127.0.0.1:20128/v1
NINEROUTER_API_KEY=your_ninerouter_api_key
NINEROUTER_DEFAULT_MODEL=ag/gemini-3-flash

# --- Cloud LLM Fallbacks (Digunakan otomatis jika 9Router lokal tidak aktif) ---
GROQ_API_KEY=gsk_your_groq_api_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here
