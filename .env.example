# --- Supabase Database & Auth Configuration ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.dummy_anon_key
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.dummy_service_role_key

# --- Edge Device Security (CV Engine to Next.js API) ---
EDGE_DEVICE_SECRET=dev-edge-secret-key-2026

# --- Base Application URL ---
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- WhatsApp Gateway Service (Opsional / Fonnte / Wablas / Twilio) ---
WHATSAPP_API_TOKEN=your_whatsapp_gateway_token
WHATSAPP_API_URL=https://api.fonnte.com/send

# --- Local AI LLM Gateway (9Router / Hermes / OpenRouter) ---
NINEROUTER_BASE_URL=http://localhost:8000/v1
NINEROUTER_API_KEY=your_ninerouter_or_openrouter_api_key
NINEROUTER_DEFAULT_MODEL=meta-llama/llama-3.1-8b-instruct
